<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_objectpose</name>
  <version>0.0.0</version>
  <description>IFRA-Cranfield (Cranfield University, UK). Package: IFRA_ObjectPose - ObjectPose GzPlugin (ROS 2)</description>

  <author>Mikel Bueno Viso</author>
  <maintainer email="Mikel.Bueno-Viso@cranfield.ac.uk">Mikel Bueno Viso</maintainer>
  
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 deps -->
  <depend>rclcpp</depend>
  <depend>objectpose_msgs</depend>

  <!-- Fortress libraries (Ignition names) -->
  <exec_depend>ignition-gazebo6</exec_depend>
  <exec_depend>ignition-plugin1</exec_depend>
  <exec_depend>ignition-math6</exec_depend>
  <exec_depend>ignition-common4</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>