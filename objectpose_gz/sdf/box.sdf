<sdf version="1.8">

  <model name="$(name)">

    <static>false</static>

    <link name="box">

      <pose>0 0 0 0 0 0</pose>

      <inertial>

        <mass>0.1</mass>

        <inertia>
          <ixx>0.000015</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.000015</iyy>
          <iyz>0.0</iyz>
          <izz>0.000015</izz>
        </inertia>
      </inertial>

      <collision name="box_collision">

        <pose>0 0 0 0 0 0</pose>

        <geometry>
          <box><size>0.03 0.03 0.03</size></box>
        </geometry>

        <surface>
          <contact>
            <collide_without_contact>false</collide_without_contact>
          </contact>
          <friction>
            <ode>
              <mu>100.0</mu>
              <mu2>100.0</mu2>
            </ode>
          </friction>
        </surface>

      </collision>

      <visual name="box_visual">

        <pose>0 0 0 0 0 0</pose>

        <geometry>
          <box><size>0.03 0.03 0.03</size></box>
        </geometry>

      </visual>

    </link>

    <!-- ObjectPose plugin (Gazebo Harmonic system plugin) -->
    <plugin name="ros2_objectpose_plugin" filename="libros2_objectpose_plugin.so">
      <topic>$(name)/ObjectPose</topic>
      <object_name>$(name)</object_name>
    </plugin>
  </model>

</sdf>
